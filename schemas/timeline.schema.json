{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "pqc/timeline@1",
 "title": "Episode timeline",
 "description": "Ordered cues the renderer plays. Blocking cues advance time until done; \"wait\": false runs a cue alongside the next. Positions are in tiles [x, y].",
 "type": "object",
 "required": [
  "schema",
  "id",
  "fps",
  "cues"
 ],
 "$defs": {
  "xy": {
   "type": "array",
   "items": {
    "type": "number"
   },
   "minItems": 2
  },
  "roll": {
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "type": "string"
    }
   }
  },
  "cue": {
   "type": "object",
   "required": [
    "op"
   ],
   "properties": {
    "op": {
     "type": "string",
     "enum": [
      "scene",
      "spawn",
      "despawn",
      "face",
      "move",
      "camera",
      "say",
      "narrate",
      "emote",
      "wait",
      "location_card",
      "title",
      "progress",
      "lantern",
      "time_of_day",
      "music",
      "music_stop",
      "sfx",
      "fade",
      "roll",
      "battle_start",
      "battle_end",
      "battle_attack",
      "battle_cast",
      "battle_faint",
      "battle_revive",
      "dm_intro",
      "initiative",
      "battle_turn",
      "battle_move",
      "battle_note"
     ]
    },
    "wait": {
     "type": "boolean"
    },
    "map": {
     "type": "string"
    },
    "time_of_day": {
     "type": "string",
     "enum": [
      "day",
      "morning",
      "dusk",
      "evening",
      "night"
     ]
    },
    "camera": {
     "$ref": "#/$defs/xy"
    },
    "follow": {
     "type": "string"
    },
    "actor": {
     "type": "string"
    },
    "sprite": {
     "type": "string"
    },
    "name": {
     "type": "string"
    },
    "at": {
     "$ref": "#/$defs/xy"
    },
    "to": {
     "anyOf": [
      {
       "$ref": "#/$defs/xy"
      },
      {
       "type": "string"
      }
     ]
    },
    "facing": {
     "type": "string",
     "enum": [
      "down",
      "up",
      "left",
      "right"
     ]
    },
    "face": {
     "type": "string",
     "enum": [
      "down",
      "up",
      "left",
      "right"
     ]
    },
    "path": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/xy"
     },
     "minItems": 1
    },
    "speed": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 20
    },
    "speaker": {
     "type": "string"
    },
    "text": {
     "type": "string",
     "minLength": 1
    },
    "emote": {
     "type": "string"
    },
    "duration": {
     "type": "number",
     "minimum": 0
    },
    "seconds": {
     "type": "number",
     "minimum": 0
    },
    "lines": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "id": {
     "type": "string"
    },
    "state": {
     "type": "string",
     "enum": [
      "lit",
      "flicker",
      "dead"
     ]
    },
    "preset": {
     "type": "string"
    },
    "track": {
     "type": "string"
    },
    "volume": {
     "type": "number",
     "minimum": 0,
     "maximum": 2
    },
    "fade_in": {
     "type": "number"
    },
    "fade_out": {
     "type": "number"
    },
    "from": {
     "type": "string",
     "enum": [
      "black",
      "clear"
     ]
    },
    "roll": {
     "$ref": "#/$defs/roll"
    },
    "label": {
     "type": "string"
    },
    "line": {
     "type": "string"
    },
    "target": {
     "type": "string"
    },
    "hit": {
     "type": "boolean"
    },
    "critical": {
     "type": "boolean"
    },
    "damage": {
     "type": "integer",
     "minimum": 0
    },
    "hp_after": {
     "type": [
      "integer",
      "null"
     ]
    },
    "ranged": {
     "type": "boolean"
    },
    "spell": {
     "type": "string"
    },
    "results": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "target"
      ]
     }
    },
    "party": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id"
      ]
     }
    },
    "enemies": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id",
       "sprite"
      ]
     }
    },
    "result": {
     "type": "string",
     "enum": [
      "victory",
      "defeat",
      "fled"
     ]
    },
    "xp": {
     "type": "integer",
     "minimum": 0
    },
    "placeholder": {
     "type": "boolean"
    },
    "narrate_hint": {
     "type": "string"
    },
    "subtitle": {
     "type": "string"
    },
    "title": {
     "type": "string"
    },
    "order": {
     "type": "array"
    },
    "round": {
     "type": "integer"
    },
    "area": {
     "type": "array"
    },
    "toward": {
     "$ref": "#/$defs/xy"
    },
    "hold": {
     "type": "number"
    },
    "banner": {
     "type": "string"
    },
    "arena": {
     "type": "boolean"
    },
    "count": {
     "type": "integer"
    },
    "cps": {
     "type": "number",
     "minimum": 5,
     "maximum": 80
    }
   }
  }
 },
 "properties": {
  "schema": {
   "const": "pqc/timeline@1"
  },
  "id": {
   "type": "string"
  },
  "title": {
   "type": "string"
  },
  "fps": {
   "type": "integer",
   "enum": [
    24,
    25,
    30,
    60
   ]
  },
  "seed": {
   "type": "string"
  },
  "tail": {
   "type": "number",
   "minimum": 0
  },
  "cues": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/cue"
   },
   "minItems": 1
  },
  "reading": {
   "type": "object",
   "properties": {
    "cps": {
     "type": "number"
    },
    "hold_base": {
     "type": "number"
    },
    "hold_per_char": {
     "type": "number"
    }
   }
  }
 }
}