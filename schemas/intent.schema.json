{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pqc/intent@1",
  "title": "Combat intent",
  "description": "What a creature tries to do. Produced by the planner or tactical model, validated and resolved by pqc.combat.Encounter.act().",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": {"type": "string", "enum": ["move", "attack", "cast", "dash", "disengage", "dodge", "hide", "help", "second_wind", "action_surge", "use_item", "stabilize", "stand_up", "end_turn"]},
    "actor": {"type": "string"},
    "to": {"type": "array", "items": {"type": "integer"}, "minItems": 2},
    "attack": {"type": "string"},
    "target": {"type": "string"},
    "targets": {"type": "array", "items": {"type": "string"}},
    "spell": {"type": "string"},
    "level": {"type": "integer", "minimum": 0, "maximum": 9},
    "free": {"type": "boolean"},
    "bonus": {"type": "boolean"},
    "item": {"type": "string"},
    "why": {"type": "string"}
  }
}
