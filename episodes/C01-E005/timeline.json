    {
      "op": "narrate",
      "text": "Three goblins around a fire, a patched tent, and a cart with something grey in its straw."
    },
    {
      "op": "narrate",
      "text": "Tamsin walks into the light as if she owns the woods."
    },
    {
      "op": "say",
      "text": "Evening, lads! Boss sent me. Change of plan: the stones go tonight. And where's my supper?",
      "speaker": "tamsin",
      "emote": "happy"
    },
