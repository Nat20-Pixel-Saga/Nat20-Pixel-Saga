    {
      "op": "narrate",
      "text": "The north trail opens into a clearing ringed with pale birches. Nothing moves. Nothing sings."
    },
    {
      "op": "say",
      "text": "Too open. Too quiet. Don't like it.",
      "speaker": "brannoc"
    },
    {
      "op": "camera",
      "to": [
        12,
        10
      ],
      "duration": 0.9
    },
    {
      "op": "say",
      "text": "Pell. Up, please. Show me.",
      "speaker": "ilsevel"
    },
    {
      "op": "move",
      "actor": "pell",
      "path": [
        [
          13,
          4
        ]
      ],
      "speed": 4,
      "face": "up",
      "wait": false
    },
    {
      "op": "narrate",
      "text": "Pell lifts into the birches. Ilsevel closes her eyes and, for the first time in her life, sees through someone else's."
    },
    {
      "op": "roll",
      "roll": {
        "id": "r0000",
