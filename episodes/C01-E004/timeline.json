    {
      "op": "dm_intro",
      "title": "Wolves at the Birches",
      "subtitle": "Campaign 1: The Lantern Road  -  Level 1  -  4 Emberfall 1047 AK",
      "text": "Someone took the core out of Lantern Thirty-Seven by hand, and a goblin trail runs from the dead lantern into Thornpike Woods. Four strangers are following it: Brannoc the soldier, Ilsevel the Lamplighter archivist, Tamsin the card player and Oriel the priestess. Night has come down fast under the pines, and the woods are no longer quiet."
    },
    {
      "op": "music",
      "track": "dark_forest",
      "fade_in": 1.0,
      "volume": 0.45
    },
    {
      "op": "location_card",
      "text": "Thornpike Woods  -  The Fork in the Trail  -  Night",
      "duration": 3.0
    },
    {
      "op": "wait",
      "seconds": 0.4
    },
    {
      "op": "narrate",
      "text": "Night comes early under the pines. Where the trail forks at a great dead stump, the dark is total for anyone without elven or dwarven eyes."
    },
    {
      "op": "say",
      "text": "I can't see my own feet. Big Man, are my feet still there?",
      "speaker": "tamsin",
      "emote": "sweat"
    },
    {
      "op": "say",
      "text": "Both of them. Stop treading on my heels.",
      "speaker": "brannoc"
    },
    {
      "op": "camera",
      "to": [
        14,
        16
      ],
      "duration": 0.9
    },
    {
      "op": "say",
      "text": "Which way did they go? It all looks like the inside of a sack.",
      "speaker": "oriel"
    },
    {
      "op": "say",
      "text": "Three trails. Ground's too trampled to tell.",
      "speaker": "brannoc"
    },
    {
      "op": "say",
      "text": "Then we need better eyes than ours. Give me an hour.",
      "speaker": "ilsevel"
    },
    {
      "op": "move",
      "actor": "ilsevel",
      "path": [
        [
          16,
          16
        ],
        [
          17,
          15
        ]
      ],
      "speed": 4,
      "face": "right"
    },
    {
      "op": "narrate",
      "text": "Ilsevel kneels by the stump with her spellbook, a pinch of incense and a little brass dish of charcoal. The ritual takes most of an hour."
    },
    {
      "op": "say",
      "text": "Eleven trees. Twelve. Something moving, east. Gone.",
      "speaker": "brannoc"
    },
    {
      "op": "say",
      "text": "Big Man. You're counting trees.",
      "speaker": "tamsin"
    },
    {
      "op": "say",
      "text": "Somebody has to.",
      "speaker": "brannoc"
    },
    {
      "op": "sfx",
      "id": "magic"
    },
    {
      "op": "spawn",
      "actor": "pell",
      "sprite": "pell",
      "at": [
        18,
        15
      ],
      "facing": "left",
      "name": "Pell"
    },
    {
      "op": "narrate",
      "text": "The charcoal flares blue. When the light fades, a small brown owl is sitting beside the stump, blinking at her."
    },
    {
      "op": "say",
      "text": "Hello. I have read about familiars for thirty years. You are smaller than the diagrams.",
      "speaker": "ilsevel",
      "emote": "exclaim"
    },
    {
      "op": "emote",
      "actor": "pell",
      "emote": "question",
      "duration": 1.2
    },
    {
      "op": "say",
      "text": "Pell. Your name is Pell.",
      "speaker": "ilsevel"
    },
    {
      "op": "say",
      "text": "He's beautiful, Ilsevel.",
      "speaker": "oriel",
      "emote": "smile"
    },
    {
      "op": "say",
      "text": "Hello, little feathers. Who's a handsome owl, then?",
      "speaker": "tamsin",
      "emote": "love"
    },
    {
      "op": "emote",
      "actor": "pell",
      "emote": "angry",
      "duration": 1.2
    },
    {
      "op": "say",
      "text": "Pell says you smell of cards and onions. I am paraphrasing. He was ruder.",
      "speaker": "ilsevel"
    },
    {
      "op": "say",
      "text": "He loves me. I can tell.",
      "speaker": "tamsin",
      "emote": "happy"
    },
    {
      "op": "narrate",
      "text": "Ilsevel turns away to put her spellbook back in her satchel, and takes rather longer over it than she needs to."
    },
    {
      "op": "fade",
      "to": "black",
      "duration": 0.7
    },
